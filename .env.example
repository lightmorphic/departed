# Copy this file to .env and fill it in. docker-compose.yml reads it, so you
# never have to edit the compose file itself.

# Where you get the check-in emails.
OWNER_EMAIL=you@example.com

# Who gets the encrypted archive if you stop responding.
RECIPIENT_EMAIL=trusted.person@example.com

# Outbound mail server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=you@example.com
# starttls (port 587, usual), ssl (port 465) or none (port 25, local relay only).
SMTP_SECURITY=starttls

# Password for the dashboard. Pick something long. Without it the dashboard is
# locked, though the timer keeps running and your emailed check-in links still work.
DASHBOARD_PASSWORD=change-me-to-something-long

# The address the check-in links point at. It has to work from wherever you
# read your email, so use the address you reach the server on from outside
# the house, not a name only your home network knows.
BASE_URL=https://departed.example.com

# The timing. Days can be fractions (0.01 = about 15 minutes) for testing.
CHECKIN_INTERVAL_DAYS=10
REMINDER_COUNT=10
REMINDER_INTERVAL_DAYS=1

# Port you open in the browser: http://<server>:4160
DEPARTED_PORT=4160

# Host folder for the database and log. Owned by user 1000 on the host.
DEPARTED_DATA=/opt/departed

# Host folder holding your already-encrypted archive. Mounted read-only.
# One file is attached as-is; several files are zipped first.
ARCHIVE_DIR=/opt/departed/archive

TZ=Europe/London
