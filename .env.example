# Copy this to .env. There are only two things here, and neither is a secret.
# Everything else is set on the app's own settings page in the browser.

# The port you open in the browser: http://<your-server>:4160
DEPARTED_PORT=4160

# The folder on the server that holds the database, your files and the log.
# Back this folder up and you have everything.
DEPARTED_DATA=/opt/departed

# Optional. Largest single upload, in megabytes. Most mail servers refuse
# attachments over about 25 MB anyway.
# MAX_UPLOAD_MB=64
